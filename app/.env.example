# Acropolis Notes — environment variables (Phase 8).
#
# Copy this to app/.env (which is gitignored) and fill in values. Every variable
# is OPTIONAL for local development:
#   - if SECRET_KEY is unset, the app generates a random one at startup (sessions
#     will not survive a restart);
#   - the Gemini AI backend is simply unavailable without GEMINI_API_KEY (the
#     local Ollama backend needs no key).
# NEVER put real secrets in this example file — it is committed.

# Flask session-signing key. Set a strong, stable value in any real deployment.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Demo "account API key" surfaced on /settings. Not a real credential.
ADMIN_API_KEY=

# Google AI Studio key for the Gemini AI-assistant backend. Leave blank to use
# only the local Ollama backend.
GEMINI_API_KEY=

# Gemini model id (optional; defaults to gemini-2.5-flash). Run
# `python list_models.py` to list the models your key can use.
GEMINI_MODEL=gemini-2.5-flash

# Set to 1/true ONLY for local debugging — never in production (the Werkzeug
# debugger is an RCE console). Defaults to off.
FLASK_DEBUG=
